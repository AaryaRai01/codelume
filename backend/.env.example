# Optional. Without this, real repositories still load in clearly labeled basic mode.
GEMINI_API_KEY=
# Choose a model available in YOUR free-tier account; no billing changes are made by this app.
GEMINI_MODEL=gemini-2.5-flash
# Optional GitHub token. Server only. Public repositories are enforced even with a token.
GITHUB_TOKEN=
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# lexical works out of the box. semantic requires requirements-semantic.txt and model download.
RETRIEVAL_MODE=lexical
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_FILES=30
DATABASE_PATH=data/codelume.sqlite3
